/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model story {
  id          Int           @id @default(autoincrement())
  user_id     Int
  content     String        @db.VarChar(200)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  expires_at  DateTime      @db.Timestamptz(6)
  is_deleted  Boolean?      @default(false)
  text_data   String?
  message     message[]
  users       users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_story_user")
  story_likes story_likes[]
  story_seen  story_seen[]

  @@index([created_at], map: "idx_story_created_at")
  @@index([user_id], map: "idx_story_user_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model story_likes {
  like_id     Int       @id @default(autoincrement())
  story_id    Int
  user_id     Int
  reaction_id Int?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  liked       Boolean
  reaction    reaction? @relation(fields: [reaction_id], references: [react_id], onDelete: Cascade, onUpdate: NoAction)
  story       story     @relation(fields: [story_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([story_id, user_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model story_seen {
  seen_id  Int      @id @default(autoincrement())
  user_id  Int
  story_id Int
  seen_at  DateTime @default(now()) @db.Timestamptz(6)
  story    story    @relation(fields: [story_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users    users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, story_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_presence {
  user_id    Int       @id
  is_online  Boolean?  @default(false)
  last_seen  DateTime? @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model message_delete_for_me {
  id         Int       @id @default(autoincrement())
  message_id Int
  deleted_at DateTime? @default(now()) @db.Timestamp(6)
  user_id    Int
  message    message   @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([message_id, user_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model wallpapers {
  id         Int       @id @default(autoincrement())
  url        String    @db.VarChar(500)
  user_id    Int       @unique(map: "unique_user_wallpaper")
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum chat_type_enum {
  private
  group
}

enum entity_type_enum {
  profile_photo
  status
  story
  online
  last_seen
}

enum file_type_enum {
  image
  video
  audio
  file
  IMAGE
  Image
  Video
  VIDEO
  File
  FILE
  Audio
  AUDIO
}

enum notification_type_enum {
  new_message
  story_like
  message_reaction
  message_reply
}

enum privacy_type_enum {
  everyone
  contacts
  only_share_with
  contacts_except
}

enum account_status {
  deleted
  active
  suspended
}

/// This enum is commented in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
enum roles_enum {
  admin
  member
  owner
}

enum theme_enum {
  light
  dark
}
